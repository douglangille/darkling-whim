{%- comment -%}Replacement for the Minimal Mistakes figure include. Params: image_path, alt, caption.{%- endcomment -%}
<figure{% if include.class %} class="{{ include.class }}"{% endif %}><img src="{{ include.image_path | relative_url }}" alt="{{ include.alt | default: '' | escape }}" loading="lazy">{% if include.caption %}<figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>{% endif %}</figure>
